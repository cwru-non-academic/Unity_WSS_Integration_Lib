<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject><IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);WSS_HOST_LIFECYCLE_TESTS</DefineConstants>
    <!-- Unity assigns serialized fields and enables Windows registration in engine builds. -->
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <ProjectReference Include="$(WSS_CORE_PROJECT)" Condition="'$(WSS_CORE_PROJECT)' != ''" />
    <Reference Include="WSS_Core_Interface" Condition="'$(WSS_CORE_PROJECT)' == ''"><HintPath>$(WSS_ARTIFACT_DIR)/WSS_Core_Interface.dll</HintPath></Reference>
    <Reference Include="WSS.Transport.Serial"><HintPath>$(WSS_TRANSPORT_ARTIFACT_DIR)/WSS.Transport.Serial.dll</HintPath></Reference>
    <Reference Include="WSS.Transport.BLE"><HintPath>$(WSS_TRANSPORT_ARTIFACT_DIR)/WSS.Transport.BLE.dll</HintPath></Reference>
    <Compile Include="../../UnityImplementation/Stimulation.cs" Link="Production/Stimulation.cs" />
    <Compile Include="../../UnityImplementation/Stimulation.Commands.cs" Link="Production/Stimulation.Commands.cs" />
    <Compile Include="../../UnityImplementation/StimulationBasic.cs" Link="Production/StimulationBasic.cs" />
    <Compile Include="../../UnityImplementation/StimualtionParams.cs" Link="Production/StimualtionParams.cs" />
    <Compile Include="../../UnityImplementation/WssTransportSupport.cs" Link="Production/WssTransportSupport.cs" />
    <Compile Include="../../UnityImplementation/WssReloadState.cs" Link="Production/WssReloadState.cs" />
  </ItemGroup>
  <Target Name="RequireInputs" BeforeTargets="ResolveReferences">
    <Error Condition="'$(WSS_CORE_PROJECT)' == '' and '$(WSS_ARTIFACT_DIR)' == ''" Text="Supply WSS_CORE_PROJECT or WSS_ARTIFACT_DIR explicitly." />
    <Error Condition="'$(WSS_TRANSPORT_ARTIFACT_DIR)' == ''" Text="Supply WSS_TRANSPORT_ARTIFACT_DIR explicitly. This is a source lifecycle test, not artifact acceptance." />
  </Target>
</Project>
